# BoundaryIQ Backend Configuration (Render Web Service)

# 1. Google Gemini AI Key (Render Secret Environment Variable)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Pinned Stable Model
GEMINI_MODEL=gemini-3.5-flash-lite

# 3. CORS Allowed Origins (Comma-separated list of deployed frontend URLs)
# Set this in Render dashboard to match your Vercel deployment URL:
# e.g. ALLOWED_ORIGINS=https://boundary-iq.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 4. Port (Render dynamically injects $PORT; defaults to 8001 in local dev)
# PORT=8001

