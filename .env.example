# BoundaryIQ Production Deployment Configuration
# Target: Vercel (Frontend) + Render (Backend)

# Backend (Render Web Service Environment Variables)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vercel Environment Variables)
# Set VITE_API_BASE_URL to your Render web service URL (e.g. https://boundary-iq-backend.onrender.com)
VITE_API_BASE_URL=
